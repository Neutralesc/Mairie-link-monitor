{% extends 'web/public/base.html.j2' %}
{% block titre %}Résultats publiés{% endblock %}
{% block contenu %}
{% macro lien_externe(url) -%}
{%- if url|est_http -%}
<a class="fr-link" href="{{ url }}" target="_blank" rel="noopener noreferrer nofollow" title="{{ url }}">{{ url|tronquer }}<span class="fr-sr-only"> (nouvelle fenêtre)</span></a>
{%- else -%}
<span title="{{ url }}">{{ url|tronquer }}</span>
{%- endif -%}
{%- endmacro %}
<h1>Résultats publiés</h1>
<p class="fr-text--lead">Liens vers les pages « Vos questions » repérés sur les sites des communes, département par département.</p>
{% if alerte %}<div class="fr-alert fr-alert--warning fr-mb-4w" role="alert"><p>{{ alerte }}</p></div>{% endif %}

<h2 class="fr-h4" id="chiffres-cles">Chiffres clés</h2>
<div class="fr-grid-row fr-grid-row--gutters fr-mb-4w">
  {% for valeur, nom in chiffres %}
  <div class="fr-col-12 fr-col-sm-6 fr-col-md-4"><div class="fr-card fr-p-2w">
    <p class="fr-h2 fr-mb-1w">{{ valeur }}</p><p class="fr-mb-0">{{ nom }}</p>
  </div></div>
  {% endfor %}
</div>

<h2 class="fr-h4" id="derniere-analyse">Dernière analyse</h2>
{% if analyse_en_cours %}<p class="fr-mb-2w" role="status">Une analyse est en cours.</p>{% endif %}
{% if derniere_analyse %}
{% set lib, modif = STATUTS_ANALYSE.get(derniere_analyse.statut, (derniere_analyse.statut, 'info')) %}
<p>Analyse {% if derniere_analyse.statut == 'terminee' %}<a class="fr-link" href="/campagnes/{{ derniere_analyse.id }}">n° {{ derniere_analyse.id }}</a>{% else %}n° {{ derniere_analyse.id }}{% endif %}, commencée le {{ derniere_analyse.debut|date }} :
  <span class="fr-badge fr-badge--{{ modif }}">{{ lib }}</span></p>
{% else %}<p>Aucune analyse pour le moment.</p>{% endif %}

<div class="fr-callout fr-mb-4w"><h2 class="fr-callout__title">Rapports</h2>
  <p class="fr-callout__text">Consultez le résultat de la dernière analyse de chaque département.</p>
  <a class="fr-btn" href="/rapports">Voir les rapports</a></div>

<form method="get" action="/" role="search" class="fr-mb-4w">
  <div class="fr-input-group">
    <label class="fr-label" for="q">Rechercher un département, par code ou par nom</label>
    <input class="fr-input" id="q" name="q" type="search" value="{{ q }}" maxlength="100">
  </div>
  <button class="fr-btn" type="submit">Rechercher</button>
  {% if q %}<a class="fr-link fr-ml-2w" href="/">Afficher tous les départements</a>{% endif %}
</form>

<h2 class="fr-h4" id="departements-publies">Départements publiés</h2>
<p class="fr-alert fr-alert--info fr-alert--sm fr-mb-2w" role="status">{% if not total %}Aucun département publié pour le moment.{% elif q %}{{ resumes|length }} département{{ 's' if resumes|length > 1 }} correspond{{ 'ent' if resumes|length > 1 }} à la recherche.{% else %}Tous les départements publiés sont affichés.{% endif %}</p>
<div class="fr-table fr-table--no-scroll"><div class="fr-table__wrapper"><div class="fr-table__container"><div class="fr-table__content">
<table>
  <caption>Dernière publication de chaque département, avec le nombre de communes par résultat</caption>
  <thead><tr>
    <th scope="col">Département</th><th scope="col">Dernière publication</th><th scope="col">Communes</th>
    <th scope="col">Avec lien</th><th scope="col">À vérifier</th><th scope="col">Sans lien</th>
    <th scope="col">Non analysables</th><th scope="col">Consulter</th>
  </tr></thead>
  <tbody>{% for r in resumes %}<tr>
    <th scope="row">{{ r.code }} {{ r.nom }}</th>
    <td>{{ r.date|date or 'Non renseignée' }}{% if r.statut_campagne == 'interrompue' %}<br><span class="fr-badge fr-badge--sm fr-badge--warning fr-badge--no-icon">Résultats partiels</span>{% endif %}</td>
    <td>{{ r.nb_communes }}</td>
    <td>{{ r.nb_communes_avec_lien }}</td>
    <td>{{ r.nb_communes_a_verifier }}</td>
    <td>{{ r.nb_communes_sans_lien }}</td>
    <td>{{ r.nb_communes_non_analysables }}</td>
    <td><a class="fr-link" href="/departement/{{ r.code }}">Consulter<span class="fr-sr-only"> {{ r.nom }}</span></a>
      · <a class="fr-link" href="/departement/{{ r.code }}.csv">CSV<span class="fr-sr-only"> de {{ r.nom }}</span></a></td>
  </tr>{% else %}<tr><td colspan="8">{% if total %}Aucun département ne correspond à cette recherche.{% else %}Aucun résultat publié pour le moment.{% endif %}</td></tr>{% endfor %}</tbody>
</table>
</div></div></div></div>

<h2 class="fr-h4 fr-mt-6w" id="nouveaux-liens">Nouveaux liens</h2>
{% if total_nouveaux %}
<p class="fr-mb-2w" role="status">{{ total_nouveaux }} commune{{ 's' if total_nouveaux > 1 }} avec un nouveau lien depuis {{ fenetre }} jours.{% if total_nouveaux > nouveaux|length %} Les {{ nouveaux|length }} plus récentes sont affichées ; le tableau complet ci-dessous indique aussi les nouveautés.{% endif %}</p>
{% endif %}
<div class="fr-table"><div class="fr-table__wrapper"><div class="fr-table__container"><div class="fr-table__content">
<table>
  <caption>Communes avec un lien apparu depuis {{ fenetre }} jours, de la plus récente à la plus ancienne</caption>
  <thead><tr>
    <th scope="col">Apparu le</th><th scope="col">Département</th><th scope="col">Code INSEE</th>
    <th scope="col">Nom de la commune</th><th scope="col">Page de la commune où se trouve le lien</th>
  </tr></thead>
  <tbody>{% for n in nouveaux %}<tr>
    <td>{{ n.apparu_le|date or 'Non renseignée' }}</td>
    <td>{{ n.departement }}</td>
    <td>{{ n.code_insee }}</td>
    <td>{{ n.commune }}</td>
    <td>{{ lien_externe(n.page) }}</td>
  </tr>{% else %}<tr><td colspan="5">Aucune nouvelle commune ces {{ fenetre }} derniers jours.</td></tr>{% endfor %}</tbody>
</table>
</div></div></div></div>
{% if total_nouveaux %}<p class="fr-mb-4w"><a class="fr-link" href="/#tous-les-liens">Voir le tableau complet des liens</a></p>{% endif %}

<h2 class="fr-h4 fr-mt-6w" id="tous-les-liens" tabindex="-1">Tous les liens trouvés</h2>
<p class="fr-mb-2w">Une ligne par commune : la page de la commune où figure un lien vers « Vos questions », et l'adresse visée. Seuls les liens confirmés sont listés.</p>

<form method="get" action="/#tous-les-liens" role="search" aria-label="Filtrer les liens trouvés" class="fr-mb-4w">
  <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--bottom">
    <div class="fr-col-12 fr-col-md-5">
      <div class="fr-input-group">
        <label class="fr-label" for="q-liens">Nom de commune ou code INSEE</label>
        <input class="fr-input" id="q-liens" name="q" type="search" value="{{ q }}" maxlength="100">
      </div>
    </div>
    <div class="fr-col-12 fr-col-md-4">
      <div class="fr-select-group">
        <label class="fr-label" for="dep">Département</label>
        <select class="fr-select" id="dep" name="dep">
          <option value="">Tous les départements</option>
          {% for d in depts_choix %}<option value="{{ d.code }}"{% if d.code == dep %} selected{% endif %}>{{ d.libelle }}</option>{% endfor %}
        </select>
      </div>
    </div>
    <div class="fr-col-12 fr-col-md-3">
      <button class="fr-btn" type="submit">Filtrer</button>
      {% if q or dep %}<a class="fr-link fr-ml-2w" href="/#tous-les-liens">Réinitialiser</a>{% endif %}
    </div>
  </div>
</form>

{% if alerte_liens %}<div class="fr-alert fr-alert--warning fr-alert--sm fr-mb-2w"><p>{{ alerte_liens }}</p></div>{% endif %}

{% if liens_total %}
<p class="fr-mb-2w">{{ liens_total }} commune{{ 's' if liens_total > 1 }}, page {{ liens_page }} sur {{ liens_pages }}.</p>
{% else %}
<p class="fr-mb-2w" role="status">Aucun résultat pour cette recherche.</p>
{% endif %}
<p class="fr-mb-2w"><a class="fr-link" href="{{ url_csv }}">{{ 'Télécharger les résultats filtrés (CSV)' if q or dep else 'Télécharger tout (CSV)' }}</a></p>
<div class="fr-table"><div class="fr-table__wrapper"><div class="fr-table__container"><div class="fr-table__content">
<table>
  <caption>Liens trouvés par commune, une ligne par commune avec sa page et son adresse visée</caption>
  <thead><tr>
    <th scope="col">Département</th><th scope="col">Code INSEE</th><th scope="col">Nom de la commune</th>
    <th scope="col">Page de la commune où se trouve le lien vers Vos questions</th>
    <th scope="col">Lien vers vosquestions</th><th scope="col">Apparu le</th>
  </tr></thead>
  <tbody>{% for l in liens %}<tr>
    <td>{{ l.departement }}</td>
    <td>{{ l.code_insee }}</td>
    <td>{{ l.commune }}</td>
    <td>{{ lien_externe(l.page) }}</td>
    <td>{{ lien_externe(l.cible) if l.cible else 'Non renseignée' }}</td>
    <td>{% if l.recent %}<span class="fr-badge fr-badge--sm fr-badge--info fr-badge--no-icon">nouveau</span> {% endif %}{{ l.apparu_le|date or 'Non renseignée' }}</td>
  </tr>{% else %}<tr><td colspan="6">Aucun résultat.</td></tr>{% endfor %}</tbody>
</table>
</div></div></div></div>
{% if liens_pages > 1 %}{{ liens_pagination }}{% endif %}
{% endblock %}
