{% extends 'web/base.html.j2' %}
{% block titre %}Accueil{% endblock %}
{% block contenu %}
<h1>Veille des liens Vos questions</h1>
<p class="fr-text--lead">Suivez la présence de liens vers vosquestions.ecologie-territoires.gouv.fr sur les sites des mairies.</p>
{% if alerte %}<div class="fr-alert fr-alert--warning fr-mb-4w" role="alert"><p>{{ alerte }}</p></div>{% endif %}
{% if analyse_en_cours %}<div class="fr-alert fr-alert--info fr-mb-4w" role="status"><p>Une analyse est en cours. <a href="/suivi">Voir le suivi</a></p></div>{% endif %}
<div class="fr-callout fr-mb-4w"><h2 class="fr-callout__title">Rapports</h2>
  <p class="fr-callout__text">Consultez le résultat de la dernière analyse de chaque département.</p>
  <a class="fr-btn" href="/rapports">Voir les rapports</a></div>
<h2 class="fr-h4">Résultats publiés</h2>
<div class="fr-grid-row fr-grid-row--gutters fr-mb-4w">
  {% for valeur, nom in chiffres %}
  <div class="fr-col-12 fr-col-sm-6 fr-col-md-3"><div class="fr-card fr-p-2w">
    <p class="fr-h2 fr-mb-1w">{{ valeur }}</p><p class="fr-mb-0">{{ nom }}</p>
  </div></div>
  {% endfor %}
</div>
<h2 class="fr-h4">Dernière analyse</h2>
{% if derniere %}
{% set lib, modif = STATUTS_ANALYSE.get(derniere.statut, (derniere.statut, 'info')) %}
<p>Analyse <a href="/campagnes/{{ derniere.id }}">n° {{ derniere.id }}</a>, commencée le {{ derniere.debut|date }} :
  <span class="fr-badge fr-badge--{{ modif }}">{{ lib }}</span></p>
{% else %}<p>Aucune analyse pour le moment.</p>{% endif %}
<ul class="fr-btns-group fr-btns-group--inline-md">
  <li><a class="fr-btn" href="/analyse">Lancer une analyse</a></li>
  <li><a class="fr-btn fr-btn--secondary" href="/suivi">Suivi de l'analyse</a></li>
</ul>
{% endblock %}
