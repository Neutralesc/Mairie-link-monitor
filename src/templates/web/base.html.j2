<!DOCTYPE html>
<html lang="fr" data-fr-scheme="system">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>{% block titre %}{% endblock %} - Veille des liens Vos questions</title>
  <link rel="apple-touch-icon" href="/static/dsfr/favicon/apple-touch-icon.png">
  <link rel="icon" href="/static/dsfr/favicon/favicon.svg" type="image/svg+xml">
  <link rel="shortcut icon" href="/static/dsfr/favicon/favicon.ico" type="image/x-icon">
  <link rel="manifest" href="/static/dsfr/favicon/manifest.webmanifest" crossorigin="use-credentials">
  <link rel="stylesheet" href="/static/dsfr/dsfr/dsfr.min.css">
  <link rel="stylesheet" href="/static/dsfr/utility/icons/icons.min.css">
  <style>.mlm-journal { white-space: pre-wrap; overflow-wrap: anywhere; font-size: .875rem; }</style>
</head>
<body>
  <div class="fr-skiplinks">
    <nav class="fr-container" role="navigation" aria-label="Accès rapide"><ul class="fr-skiplinks__list">
      <li><a class="fr-link" href="#contenu">Contenu</a></li>
      <li><a class="fr-link" href="#footer">Pied de page</a></li>
    </ul></nav>
  </div>
  <header role="banner" class="fr-header">
    <div class="fr-header__body"><div class="fr-container"><div class="fr-header__body-row">
      <div class="fr-header__brand fr-enlarge-link">
        <div class="fr-header__brand-top">
          <div class="fr-header__logo"><p class="fr-logo">Ministères<br>Transition écologique<br>Aménagement du territoire<br>Transports<br>Ville et Logement</p></div>
          <div class="fr-header__navbar">
            <button class="fr-btn--menu fr-btn" data-fr-opened="false" aria-controls="modal-menu" id="btn-menu" title="Menu">Menu</button>
          </div>
        </div>
        <div class="fr-header__service">
          <a href="/" title="Accueil - Veille des liens Vos questions"><p class="fr-header__service-title">Veille des liens Vos questions</p></a>
          <p class="fr-header__service-tagline">Liens vers vosquestions.ecologie-territoires.gouv.fr sur les sites des mairies</p>
        </div>
      </div>
    </div></div></div>
    <div class="fr-header__menu fr-modal" id="modal-menu" aria-labelledby="btn-menu">
      <div class="fr-container">
        <button class="fr-btn--close fr-btn" aria-controls="modal-menu" title="Fermer">Fermer</button>
        <div class="fr-header__menu-links"></div>
        <nav class="fr-nav" id="nav" role="navigation" aria-label="Menu principal"><ul class="fr-nav__list">
          {% for cle, url, nom in [('accueil','/','Accueil'),('analyse','/analyse','Analyse'),('suivi','/suivi','Suivi'),('rapports','/rapports','Rapports'),('resultats','/resultats','Résultats'),('campagnes','/campagnes','Historique')] %}
          <li class="fr-nav__item"><a class="fr-nav__link" href="{{ url }}" target="_self"{% if actif == cle %} aria-current="page"{% endif %}>{{ nom }}</a></li>
          {% endfor %}
        </ul></nav>
      </div>
    </div>
  </header>
  <main id="contenu" role="main" class="fr-container fr-my-4w">
    {% block fil %}{% endblock %}
    {% block contenu %}{% endblock %}
  </main>
  <footer class="fr-footer" role="contentinfo" id="footer">
    <div class="fr-container"><div class="fr-footer__body">
      <div class="fr-footer__brand"><p class="fr-logo">Ministères<br>Transition écologique<br>Aménagement du territoire<br>Transports<br>Ville et Logement</p></div>
      <div class="fr-footer__content"><p class="fr-footer__content-desc">Outil de veille. Il ne garantit pas l'exhaustivité des résultats : chaque compte rendu indique ses limites.</p></div>
    </div>
    <div class="fr-footer__bottom"><ul class="fr-footer__bottom-list">
      <li class="fr-footer__bottom-item"><span class="fr-footer__bottom-link">Système de design de l'État 1.15.4</span></li>
    </ul></div></div>
  </footer>
  <script type="module" src="/static/dsfr/dsfr.module.min.js"></script>
  <script nomodule src="/static/dsfr/dsfr.nomodule.min.js"></script>
  <script src="/static/app.js" defer></script>
</body>
</html>
